GROQ_API_KEY=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DATABASE_URL=

# stub | live — stub means no network call and no key required; the full benchmark must run
# offline so a reviewer without any key still sees the number. In live mode, Groq is tried
# first (fast, generous published rate limits), Gemini is the fallback on any Groq failure --
# either key alone is enough to go live, both together get you the fallback.
VASOOL_LLM=stub
